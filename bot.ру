# 🌐 выбор языка по кнопке
@dp.message_handler(lambda msg: msg.text in ["🇷🇺 Русский", "🇺🇸 English", "🇺🇿 Oʻzbekcha"])
async def lang_select(message: types.Message):
    lang_map = {
        "🇷🇺 Русский": "ru",
        "🇺🇸 English": "en",
        "🇺🇿 Oʻzbekcha": "uz"
    }
    set_user_language(message.from_user.id, lang_map[message.text])
    await message.answer("✅ Язык обновлён!", reply_markup=ReplyKeyboardRemove())

